{
  "name": "financeapp-desktop",
  "productName": "FinanceApp",
  "version": "1.7.0",
  "description": "Chromium-based desktop client for MoneyManagerEx .mmb files — desktop twin of the FinanceApp Android app",
  "author": "KonH",
  "license": "MIT",
  "private": true,
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:5173 && cross-env FINANCEAPP_DEV_SERVER=http://localhost:5173 electron .\"",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "node --test tests/domain.test.mjs tests/database.test.mjs",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package": "npm run build && electron-builder --win --mac",
    "verify": "npm run build && npm run test",
    "package:win:unsigned": "npm run build && electron-builder --win --config.win.signAndEditExecutable=false"
  },
  "dependencies": {
    "sql.js": "1.14.2"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/sql.js": "1.4.9",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "electron": "44.2.0",
    "electron-builder": "26.0.12",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "wait-on": "9.0.1"
  }
}
