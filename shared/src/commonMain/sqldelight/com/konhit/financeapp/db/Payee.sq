CREATE TABLE IF NOT EXISTS PAYEE_V1 (
    PAYEEID         INTEGER NOT NULL PRIMARY KEY,
    PAYEENAME       TEXT    NOT NULL,
    CATEGID         INTEGER,
    NUMBER          TEXT,
    WEBSITE         TEXT,
    NOTES           TEXT,
    ACTIVE          INTEGER
);

selectFirst:
SELECT PAYEEID FROM PAYEE_V1 LIMIT 1;

insert:
INSERT INTO PAYEE_V1 (PAYEEID, PAYEENAME)
VALUES (:payeeId, :name);

count:
SELECT COUNT(*) FROM PAYEE_V1;
