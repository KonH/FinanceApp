CREATE TABLE IF NOT EXISTS CATEGORY_V1 (
    CATEGID     INTEGER NOT NULL PRIMARY KEY,
    CATEGNAME   TEXT    NOT NULL,
    PARENTID    INTEGER NOT NULL DEFAULT -1,
    ACTIVE      INTEGER
);

selectAll:
SELECT CATEGID, CATEGNAME, PARENTID
FROM CATEGORY_V1
ORDER BY PARENTID, CATEGNAME;

selectById:
SELECT * FROM CATEGORY_V1 WHERE CATEGID = :categId;

insert:
INSERT INTO CATEGORY_V1 (CATEGID, CATEGNAME, PARENTID)
VALUES (:categId, :name, :parentId);

update:
UPDATE CATEGORY_V1
SET CATEGNAME = :name,
    PARENTID  = :parentId
WHERE CATEGID = :categId;

delete:
DELETE FROM CATEGORY_V1 WHERE CATEGID = :categId;

hasTransactions:
SELECT COUNT(*) FROM CHECKINGACCOUNT_V1
WHERE CATEGID = :categId AND DELETEDTIME IS NULL;

count:
SELECT COUNT(*) FROM CATEGORY_V1;
