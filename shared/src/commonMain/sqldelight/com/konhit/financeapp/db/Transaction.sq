CREATE TABLE IF NOT EXISTS CHECKINGACCOUNT_V1 (
    TRANSID             INTEGER NOT NULL PRIMARY KEY,
    ACCOUNTID           INTEGER NOT NULL,
    TOACCOUNTID         INTEGER NOT NULL DEFAULT -1,
    PAYEEID             INTEGER NOT NULL DEFAULT -1,
    TRANSCODE           TEXT    NOT NULL,
    TRANSAMOUNT         REAL    NOT NULL,
    STATUS              TEXT    NOT NULL DEFAULT '',
    TRANSACTIONNUMBER   TEXT,
    NOTES               TEXT,
    CATEGID             INTEGER,
    TRANSDATE           TEXT    NOT NULL,
    LASTUPDATEDTIME     TEXT,
    DELETEDTIME         TEXT,
    FOLLOWUPID          INTEGER NOT NULL DEFAULT -1,
    TOTRANSAMOUNT       REAL    NOT NULL DEFAULT 0,
    COLOR               INTEGER NOT NULL DEFAULT -1
);

selectByAccount:
SELECT *
FROM CHECKINGACCOUNT_V1
WHERE (ACCOUNTID = :accountId OR TOACCOUNTID = :accountId)
  AND DELETEDTIME IS NULL
ORDER BY TRANSDATE DESC, TRANSID DESC;

selectById:
SELECT *
FROM CHECKINGACCOUNT_V1
WHERE TRANSID = :transId;

insert:
INSERT INTO CHECKINGACCOUNT_V1 (
    TRANSID, ACCOUNTID, TOACCOUNTID, PAYEEID,
    TRANSCODE, TRANSAMOUNT, TOTRANSAMOUNT,
    STATUS, TRANSACTIONNUMBER, NOTES, CATEGID,
    TRANSDATE, LASTUPDATEDTIME, DELETEDTIME,
    FOLLOWUPID, COLOR
) VALUES (
    :transId, :accountId, :toAccountId, :payeeId,
    :transCode, :transAmount, :toTransAmount,
    '', NULL, :notes, :categId,
    :transDate, :lastUpdatedTime, NULL,
    -1, -1
);

update:
UPDATE CHECKINGACCOUNT_V1
SET TRANSCODE        = :transCode,
    ACCOUNTID        = :accountId,
    TOACCOUNTID      = :toAccountId,
    TRANSAMOUNT      = :transAmount,
    TOTRANSAMOUNT    = :toTransAmount,
    CATEGID          = :categId,
    TRANSDATE        = :transDate,
    NOTES            = :notes,
    LASTUPDATEDTIME  = :lastUpdatedTime
WHERE TRANSID = :transId;

delete:
DELETE FROM CHECKINGACCOUNT_V1 WHERE TRANSID = :transId;

balanceComponents:
SELECT
    a.INITIALBAL AS initialBal,
    COALESCE((
        SELECT SUM(TRANSAMOUNT) FROM CHECKINGACCOUNT_V1
        WHERE ACCOUNTID = :accountId AND TRANSCODE = 'Deposit' AND DELETEDTIME IS NULL
    ), 0) AS totalDeposits,
    COALESCE((
        SELECT SUM(TRANSAMOUNT) FROM CHECKINGACCOUNT_V1
        WHERE ACCOUNTID = :accountId AND TRANSCODE = 'Withdrawal' AND DELETEDTIME IS NULL
    ), 0) AS totalWithdrawals,
    COALESCE((
        SELECT SUM(TOTRANSAMOUNT) FROM CHECKINGACCOUNT_V1
        WHERE TOACCOUNTID = :accountId AND TRANSCODE = 'Transfer' AND DELETEDTIME IS NULL
    ), 0) AS transfersIn,
    COALESCE((
        SELECT SUM(TRANSAMOUNT) FROM CHECKINGACCOUNT_V1
        WHERE ACCOUNTID = :accountId AND TRANSCODE = 'Transfer' AND DELETEDTIME IS NULL
    ), 0) AS transfersOut
FROM ACCOUNTLIST_V1 a
WHERE a.ACCOUNTID = :accountId;

countAll:
SELECT COUNT(*) FROM CHECKINGACCOUNT_V1 WHERE DELETEDTIME IS NULL;

search:
SELECT t.*
FROM CHECKINGACCOUNT_V1 t
LEFT JOIN CATEGORY_V1 c ON t.CATEGID = c.CATEGID
LEFT JOIN ACCOUNTLIST_V1 a ON t.ACCOUNTID = a.ACCOUNTID
WHERE t.DELETEDTIME IS NULL
  AND (
      t.NOTES LIKE '%' || :query || '%'
   OR CAST(t.TRANSAMOUNT AS TEXT) LIKE '%' || :query || '%'
   OR c.CATEGNAME LIKE '%' || :query || '%'
   OR a.ACCOUNTNAME LIKE '%' || :query || '%'
  )
ORDER BY t.TRANSDATE DESC, t.TRANSID DESC;
