CREATE TABLE IF NOT EXISTS INFOTABLE_V1 (
    INFOID      INTEGER NOT NULL PRIMARY KEY,
    INFONAME    TEXT    NOT NULL,
    INFOVALUE   TEXT    NOT NULL
);

selectAll:
SELECT INFONAME, INFOVALUE FROM INFOTABLE_V1;

selectByKey:
SELECT INFOVALUE FROM INFOTABLE_V1 WHERE INFONAME = :key;

insert:
INSERT INTO INFOTABLE_V1 (INFONAME, INFOVALUE) VALUES (:name, :value);

count:
SELECT COUNT(*) FROM INFOTABLE_V1;
