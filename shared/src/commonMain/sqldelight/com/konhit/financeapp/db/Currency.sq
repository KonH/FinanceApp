CREATE TABLE IF NOT EXISTS CURRENCYFORMATS_V1 (
    CURRENCYID          INTEGER NOT NULL PRIMARY KEY,
    CURRENCYNAME        TEXT    NOT NULL,
    PFX_SYMBOL          TEXT,
    SFX_SYMBOL          TEXT,
    DECIMAL_POINT       TEXT,
    THOUSANDS_SEPARATOR TEXT,
    UNIT_NAME           TEXT,
    CENT_NAME           TEXT,
    SCALE               INTEGER,
    BASECONVRATE        REAL,
    CURRENCY_SYMBOL     TEXT,
    GROUP_SEPARATOR     TEXT
);

selectAll:
SELECT
    CURRENCYID,
    CURRENCYNAME,
    PFX_SYMBOL,
    SFX_SYMBOL,
    DECIMAL_POINT,
    GROUP_SEPARATOR,
    SCALE,
    CURRENCY_SYMBOL
FROM CURRENCYFORMATS_V1
ORDER BY CURRENCYNAME;

selectById:
SELECT * FROM CURRENCYFORMATS_V1 WHERE CURRENCYID = :currencyId;

count:
SELECT COUNT(*) FROM CURRENCYFORMATS_V1;
